rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validProfileCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'emailVerified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'emailVerified', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && (data.email == null || (data.email is string && data.email.size() <= 254))
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.role == 'customer'
        && data.emailVerified == request.auth.token.email_verified
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validProfileUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.updatedAt is string;
    }

    function validCartWrite() {
      let data = request.resource.data;
      return data.keys().hasAll(['cart', 'wishlist'])
        && data.keys().hasOnly(['cart', 'wishlist'])
        && data.cart is list
        && data.cart.size() <= 100
        && data.wishlist is list
        && data.wishlist.size() <= 100;
    }

    function validOrderStatus(status) {
      return status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfileCreate(userId);
      allow update: if (signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && validProfileUpdate())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified'])
          && request.resource.data.emailVerified is bool);
      allow delete: if isAdmin();
    }

    match /carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validCartWrite();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Customer review writes use the Admin SDK after delivered-purchase validation.
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Customer checkout uses the Admin SDK route to recalculate canonical prices.
      allow create: if false;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'deliveredAt'
          ])
          && validOrderStatus(request.resource.data.status)
          && request.resource.data.updatedAt is string
          && (request.resource.data.status != 'delivered'
            || (request.resource.data.deliveredAt is string
              && request.resource.data.deliveredAt.size() > 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAt'])
            || (request.resource.data.status == 'delivered'
              && request.resource.data.deliveredAt is string)))
        || (signedIn()
          && request.auth.uid == resource.data.userId
          && resource.data.status in ['pending', 'confirmed']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt is string);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}